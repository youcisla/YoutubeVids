{
  "duration": 35.4,
  "cues": [
    {
      "id": 0,
      "start": 0.4,
      "end": 1.9,
      "text": "What is a robot?"
    },
    {
      "id": 1,
      "start": 1.9,
      "end": 5.841,
      "text": "A robot is something that can do a job all by itself."
    },
    {
      "id": 2,
      "start": 5.841,
      "end": 9.707,
      "text": "Some robots have arms and wheels and big shiny eyes."
    },
    {
      "id": 3,
      "start": 9.707,
      "end": 12.533,
      "text": "Some look more like boxes with lights."
    },
    {
      "id": 4,
      "start": 12.533,
      "end": 14.391,
      "text": "But here is a fun secret."
    },
    {
      "id": 5,
      "start": 14.391,
      "end": 19.745,
      "text": "Some of the smartest robots in the world do not look like robots at all."
    },
    {
      "id": 6,
      "start": 19.745,
      "end": 22.57,
      "text": "They live inside computers and phones."
    },
    {
      "id": 7,
      "start": 22.57,
      "end": 24.07,
      "text": "You cannot hug them."
    },
    {
      "id": 8,
      "start": 24.07,
      "end": 29.275,
      "text": "But they can answer your questions, draw pictures, and help you learn."
    },
    {
      "id": 9,
      "start": 29.275,
      "end": 34.182,
      "text": "If it can think a little, and do a job by itself, congratulations."
    },
    {
      "id": 10,
      "start": 34.182,
      "end": 35.682,
      "text": "It is a robot."
    }
  ]
}